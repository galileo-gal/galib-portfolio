+}
diff --git a/app/robots.js b/app/robots.js
new file mode 100644
index 0000000..71927c1
--- /dev/null
+++ b/app/robots.js
@@ -0,0 +1,9 @@
+// TODO: switch to https://galib.is-a.dev once the domain PR is merged and DNS resolves.
+const siteUrl = "https://galib-portfolio-taupe.vercel.app";
+
+export default function robots() {
+  return {
+    rules: { userAgent: "*", allow: "/" },
+    sitemap: `${siteUrl}/sitemap.xml`,
+  };
+}
diff --git a/app/sitemap.js b/app/sitemap.js
new file mode 100644
index 0000000..37c8f34
--- /dev/null
+++ b/app/sitemap.js
@@ -0,0 +1,18 @@
+import { projects } from "../lib/projects";
+
+// TODO: switch to https://galib.is-a.dev once the domain PR is merged and DNS resolves.
+const siteUrl = "https://galib-portfolio-taupe.vercel.app";
+
+export default function sitemap() {
+  const staticRoutes = ["", "/about", "/certifications", "/projects"].map((route) => ({
+    url: `${siteUrl}${route}`,
+    lastModified: new Date(),
+  }));
+
+  const projectRoutes = projects.map((p) => ({
+    url: `${siteUrl}/projects/${p.slug}`,
+    lastModified: new Date(),
+  }));
+
+  return [...staticRoutes, ...projectRoutes];
+}
